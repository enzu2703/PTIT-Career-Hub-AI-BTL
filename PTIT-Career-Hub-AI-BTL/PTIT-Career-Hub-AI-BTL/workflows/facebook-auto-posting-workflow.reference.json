            "version": 4
          },
          "conditions": [
            {
              "id": "time-match",
              "leftValue": "={{ (() => {\n  const dateStr = String($json['Ngày đăng'] || '').trim();\n  const timeStr = String($json['Giờ đăng'] || '').trim();\n  \n  // Parse linh hoạt ngày (1 hoặc 2 chữ số) và giờ (1 hoặc 2 chữ số)\n  const t = DateTime.fromFormat(`${dateStr} ${timeStr}`, 'd/M/yyyy H:mm', { zone: 'Asia/Ho_Chi_Minh' });\n  \n  if (!t.isValid) return false;\n  \n  const now = DateTime.now().setZone('Asia/Ho_Chi_Minh');\n  const diff = now.diff(t, 'minutes').minutes;\n  \n  // Cho phép đăng nếu đã đến giờ và chưa trễ quá 60 phút (bạn có thể đổi số 60 theo lịch Schedule Trigger)\n  return diff >= 0 && diff <= 60;\n})() }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
