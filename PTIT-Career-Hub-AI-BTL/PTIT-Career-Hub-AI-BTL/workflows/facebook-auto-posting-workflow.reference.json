    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Lấy dữ liệu của item hiện tại (chuẩn cho chế độ Run Once for Each Item)\nconst inputData = $input.item?.json || {};\n\n// 1. Lấy dữ liệu văn bản cần làm sạch\nconst raw = String(\n  inputData.content ||\n  inputData[\"Nội dung đầy đủ\"] ||\n  inputData.text ||\n  inputData.message?.content ||\n  \"\"\n);\n\n// 2. Xử lý làm sạch format Markdown nhưng giữ nguyên Hashtag\nconst cleaned = raw\n  .replace(/^#{1,6}\\s+/gm, \"\")\n  .replace(/\\*{1,3}([^*]+)\\*{1,3}/g, \"$1\")\n  .replace(/\\*/g, \"\")\n  .replace(/#(?=\\s|$)/g, \"\")\n  .replace(/^\\s*[-•]\\s+/gm, \"• \")\n  .replace(/_{1,2}([^_]+)_{1,2}/g, \"$1\")\n  .replace(/\\n{3,}/g, \"\\n\\n\")\n  .trim();\n\n// 3. Trả về trực tiếp 1 object (KHÔNG bọc dấu ngoặc vuông [] bên ngoài)\nreturn {\n  json: {\n    ...inputData,\n    content: cleaned,\n    platform: \"facebook\",\n   imageName: String(inputData[\"Ngày\"] || \"\").replaceAll(\"/\", \"-\") + \"_\" + String($('Read Scheduled Posts').item.json[\"Giờ đăng\"] || \"\").replaceAll(\":\", \"-\")\n  }\n};"
      },
